      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": { "200": { "description": "Current move auto-resolved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/exercise": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["exerciseKey", "units", "revision"], "properties": { "exerciseKey": { "type": "string" }, "units": { "type": "number" }, "revision": { "type": "integer" } } } } } },
        "responses": { "200": { "description": "Health progress logged and any newly earned troops banked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExerciseLogMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/chat": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["body"], "properties": { "body": { "type": "string", "maxLength": 500 } } } } } },
        "responses": { "201": { "description": "Message sent" }, "429": { "description": "Chat rate limited" } }
      }
    },
    "/api/games/{gameId}/chat/{messageId}": {
      "delete": {
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "messageId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": { "200": { "description": "Own message deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } } }
      }
    },
    "/api/games/{gameId}/chat/mutes": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["userId"], "properties": { "userId": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Participant muted" } }
      }
    },
    "/api/games/{gameId}/chat/mutes/{userId}": {
      "delete": {
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
