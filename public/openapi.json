{
  "openapi": "3.1.0",
  "info": {
    "title": "HealthRisk API",
    "version": "1.0.0",
    "description": "Authoritative multiplayer API used by the HealthRisk web and native clients. Mutations support Idempotency-Key and return X-Request-Id."
  },
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "exrisk_session" }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "minLength": 8, "maxLength": 128 },
        "description": "Reuse the same key when retrying the identical mutation."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "message", "requestId", "retryable"],
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      },
      "AuthRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 24 },
          "password": { "type": "string", "minLength": 8, "maxLength": 128 }
        }
      },
      "CreateGameRequest": {
        "type": "object",
        "required": ["practice"],
        "properties": {
          "practice": { "type": "boolean" },
          "players": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "description": "Practice seat count. Multiplayer lobbies support up to 10 joined players."
          }
        },
        "additionalProperties": true
      },
      "PublicUser": {
        "type": "object",
        "required": ["id", "username"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" }
        }
      },
      "SharedHealthGoalProgress": {
        "type": "object",
        "required": ["exerciseKey", "currentStatus", "completedDays", "trackedDays", "consistencyPercent"],
        "properties": {
          "exerciseKey": { "type": "string" },
          "currentStatus": { "enum": ["not_started", "in_progress", "goal_met"] },
          "completedDays": { "type": "integer", "minimum": 0 },
          "trackedDays": { "type": "integer", "minimum": 0, "maximum": 7 },
          "consistencyPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
        }
      },
      "SharedHealthProgress": {
        "type": "object",
        "required": ["playerId", "troopsEarned", "dailyCap", "percent", "goalsCompleted", "goalsTracked", "status", "historyWindowDays", "consistencyPercent", "goals"],
        "properties": {
          "playerId": { "type": "string" },
          "troopsEarned": { "type": "number", "minimum": 0 },
          "dailyCap": { "type": "number", "minimum": 0 },
          "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "goalsCompleted": { "type": "integer", "minimum": 0 },
          "goalsTracked": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["not_started", "in_progress", "goal_met"] },
          "historyWindowDays": { "type": "integer", "minimum": 0, "maximum": 7 },
          "consistencyPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "goals": { "type": "array", "items": { "$ref": "#/components/schemas/SharedHealthGoalProgress" } }
        }
      },
      "GameplayPlayer": {
        "type": "object",
        "required": ["id", "name", "status", "pendingReinforcements", "pendingEliminationReward", "note", "claimed", "healthProgress"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "enum": ["active", "auto_piloted", "forfeited", "eliminated"] },
          "color": { "type": ["string", "null"] },
          "pendingReinforcements": { "type": "integer", "minimum": 0 },
          "pendingEliminationReward": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" },
          "claimed": { "type": "boolean" },
          "healthProgress": {
            "oneOf": [
              { "$ref": "#/components/schemas/SharedHealthProgress" },
              { "type": "null" }
            ]
          }
        }
      },
      "GameView": {
        "type": "object",
        "required": ["id", "revision", "status", "players", "territories", "chatMessages"],
        "properties": {
          "id": { "type": "string" },
          "revision": { "type": "integer" },
          "status": { "enum": ["setup", "active", "finished", "cancelled"] },
          "practice": { "type": "boolean" },
          "yourTurn": { "type": "boolean" },
          "winnerId": { "type": ["string", "null"] },
          "currentPlayerId": { "type": ["string", "null"] },
          "phase": { "enum": ["reinforce", "attack", "fortify", "done"] },
          "dashboard": {
            "oneOf": [
              { "$ref": "#/components/schemas/GameplayDashboard" },
              { "type": "null" }
            ]
          },
          "healthLogging": { "type": "object", "additionalProperties": true },
          "exercises": { "type": "array", "items": { "$ref": "#/components/schemas/ExerciseRule" } },
          "players": { "type": "array", "items": { "$ref": "#/components/schemas/GameplayPlayer" } },
          "territories": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "chatMessages": { "type": "array", "items": { "$ref": "#/components/schemas/ChatMessage" } },
          "schedule": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      },
      "TerritoryCard": {
        "type": "object",
        "required": ["id", "territoryId", "earnedDay"],
        "properties": {
          "id": { "type": "string" },
          "territoryId": { "type": "string" },
          "earnedDay": { "type": "integer", "minimum": 0 }
        }
      },
      "GameplayCards": {
        "type": "object",
        "required": ["hand", "tradeSize", "tradeReward", "canTrade"],
        "properties": {
          "hand": { "type": "array", "items": { "$ref": "#/components/schemas/TerritoryCard" } },
          "tradeSize": { "type": "integer", "minimum": 1 },
          "tradeReward": { "type": "integer", "minimum": 1 },
          "canTrade": { "type": "boolean" }
        }
      },
      "GameplayTurnSummary": {
        "type": "object",
        "required": ["reinforcementsPlaced", "placementsMade", "attacksMade", "attackerLosses", "defenderLosses", "territoriesCaptured", "cardsTraded", "cardPending", "fortification"],
        "properties": {
          "reinforcementsPlaced": { "type": "integer", "minimum": 0 },
          "placementsMade": { "type": "integer", "minimum": 0 },
          "attacksMade": { "type": "integer", "minimum": 0 },
          "attackerLosses": { "type": "integer", "minimum": 0 },
          "defenderLosses": { "type": "integer", "minimum": 0 },
          "territoriesCaptured": { "type": "array", "items": { "type": "string" } },
          "cardsTraded": { "type": "integer", "minimum": 0 },
          "cardPending": { "type": "boolean" },
          "fortification": { "type": ["object", "null"], "additionalProperties": true }
        }
      },
      "ExerciseRule": {
        "type": "object",
        "required": ["key", "label", "unitLabel", "category", "trackingType", "troopsPerUnit", "dailyUnitCap"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "unitLabel": { "type": "string" },
          "category": { "enum": ["movement", "nutrition", "recovery"] },
          "trackingType": { "enum": ["quantity", "duration", "checkbox"] },
          "troopsPerUnit": { "type": "number", "exclusiveMinimum": 0 },
          "dailyUnitCap": { "type": ["number", "null"], "exclusiveMinimum": 0 }
        }
      },
      "ExerciseProgress": {
        "type": "object",
        "required": ["key", "label", "unitLabel", "category", "trackingType", "unitsLogged", "countedUnits", "unitCap", "troopsEarned"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "unitLabel": { "type": "string" },
          "category": { "enum": ["movement", "nutrition", "recovery"] },
          "trackingType": { "enum": ["quantity", "duration", "checkbox"] },
          "unitsLogged": { "type": "number", "minimum": 0 },
          "countedUnits": { "type": "number", "minimum": 0 },
          "unitCap": { "type": ["number", "null"], "minimum": 0 },
          "troopsEarned": { "type": "number", "minimum": 0 }
        }
      },
      "ExerciseDashboard": {
        "type": "object",
        "required": ["totalTroops", "dailyCap", "totalCapApplied", "progress"],
        "properties": {
          "totalTroops": { "type": "number", "minimum": 0 },
          "dailyCap": { "type": "number", "minimum": 0 },
          "totalCapApplied": { "type": "boolean" },
          "progress": { "type": "array", "items": { "$ref": "#/components/schemas/ExerciseProgress" } }
        }
      },
      "GameplayDashboard": {
        "type": "object",
        "required": ["playerId", "cards", "turnSummary", "exercise"],
        "properties": {
          "playerId": { "type": "string" },
          "availableReinforcements": { "type": "integer", "minimum": 0 },
          "turnStart": { "type": ["object", "null"], "additionalProperties": true },
          "cards": { "$ref": "#/components/schemas/GameplayCards" },
          "turnSummary": {
            "oneOf": [
              { "$ref": "#/components/schemas/GameplayTurnSummary" },
              { "type": "null" }
            ]
          },
          "exercise": { "$ref": "#/components/schemas/ExerciseDashboard" }
        },
        "additionalProperties": true
      },
      "ChatMessage": {
        "type": "object",
        "required": ["id", "gameId", "userId", "playerId", "username", "body", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "gameId": { "type": "string" },
          "userId": { "type": "string" },
          "playerId": { "type": "string" },
          "username": { "type": "string" },
          "body": { "type": "string", "maxLength": 500 },
          "createdAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Notification": {
        "type": "object",
        "required": ["id", "userId", "type", "title", "body", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "gameId": { "type": ["string", "null"] },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "deepLink": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "readAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "GameMutationResponse": {
        "type": "object",
        "required": ["game"],
        "properties": { "game": { "$ref": "#/components/schemas/GameView" } },
        "additionalProperties": true
      },
      "CardTradeMutationResponse": {
        "type": "object",
        "required": ["remainingBank", "remainingCards", "troopsAwarded", "game"],
        "properties": {
          "remainingBank": { "type": "integer", "minimum": 0 },
          "remainingCards": { "type": "integer", "minimum": 0 },
          "troopsAwarded": { "type": "integer", "minimum": 1 },
          "game": { "$ref": "#/components/schemas/GameView" }
        }
      },
      "EndTurnMutationResponse": {
        "type": "object",
        "required": ["game", "cardAwarded"],
        "properties": {
          "game": { "$ref": "#/components/schemas/GameView" },
          "cardAwarded": {
            "oneOf": [
              { "$ref": "#/components/schemas/TerritoryCard" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": true
      },
      "ExerciseLogMutationResponse": {
        "type": "object",
        "required": ["deltaTroops", "dayTotal", "totalCapApplied", "game"],
        "properties": {
          "deltaTroops": { "type": "integer", "minimum": 0 },
          "dayTotal": { "type": "integer", "minimum": 0 },
          "totalCapApplied": { "type": "boolean" },
          "game": { "$ref": "#/components/schemas/GameView" }
        }
      },
      "AttackRequest": {
        "type": "object",
        "required": ["revision", "fromId", "toId", "committedTroops", "stopLoss"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0 },
          "fromId": { "type": "string" },
          "toId": { "type": "string" },
          "committedTroops": {
            "type": "integer",
            "minimum": 1,
            "description": "Troops entering the battle. The origin must retain at least one troop."
          },
          "stopLoss": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum attacker casualties before combat stops. Set equal to committedTroops for an all-in attack."
          }
        }
      },
      "CombatRound": {
        "type": "object",
        "required": ["attackerDice", "defenderDice", "attackerLosses", "defenderLosses", "attackerForceAfter", "defenderForceAfter"],
        "properties": {
          "attackerDice": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 6 } },
          "defenderDice": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 6 } },
          "attackerLosses": { "type": "integer", "minimum": 0 },
          "defenderLosses": { "type": "integer", "minimum": 0 },
          "attackerForceAfter": { "type": "integer", "minimum": 0 },
          "defenderForceAfter": { "type": "integer", "minimum": 0 }
        }
      },
      "AttackResult": {
        "type": "object",
        "required": ["fromId", "toId", "endReason", "captured", "rounds", "totalAttackerLosses", "totalDefenderLosses", "survivingAttackers", "remainingDefenders", "seed"],
        "properties": {
          "fromId": { "type": "string" },
          "toId": { "type": "string" },
          "endReason": { "enum": ["capture", "stop_loss", "attacker_min"] },
          "captured": { "type": "boolean" },
          "rounds": { "type": "array", "items": { "$ref": "#/components/schemas/CombatRound" } },
          "totalAttackerLosses": { "type": "integer", "minimum": 0 },
          "totalDefenderLosses": { "type": "integer", "minimum": 0 },
          "survivingAttackers": { "type": "integer", "minimum": 0 },
          "remainingDefenders": { "type": "integer", "minimum": 0 },
          "seed": { "type": "integer" }
        }
      },
      "AttackMutationResponse": {
        "type": "object",
        "required": ["result", "game"],
        "properties": {
          "result": { "$ref": "#/components/schemas/AttackResult" },
          "game": { "$ref": "#/components/schemas/GameView" }
        }
      },
      "RevisionBody": {
        "type": "object",
        "required": ["revision"],
        "properties": { "revision": { "type": "integer", "minimum": 0 } },
        "additionalProperties": true
      },
      "OkResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": { "ok": { "const": true } },
        "additionalProperties": true
      }
    }
  },
  "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
  "paths": {
    "/api/meta": {
      "get": { "security": [], "responses": { "200": { "description": "API capabilities" } } }
    },
    "/api/auth/signup": {
      "post": {
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthRequest" } } } },
        "responses": { "200": { "description": "Session token and user" }, "400": { "description": "Invalid account", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
      }
    },
    "/api/auth/login": {
      "post": {
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthRequest" } } } },
        "responses": { "200": { "description": "Session token and user" }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/api/auth/me": {
      "get": { "responses": { "200": { "description": "Current account; use GET /api/games for its complete game library" } } }
    },
    "/api/auth/logout": {
      "post": { "responses": { "200": { "description": "Session ended", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } } } }
    },
    "/api/account": {
      "delete": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Account deleted" }, "401": { "description": "Password confirmation failed" } }
      }
    },
    "/api/games": {
      "get": { "responses": { "200": { "description": "Current and historical games" } } },
      "post": {
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateGameRequest" } } } },
        "responses": { "201": { "description": "Created game; accounts may participate in multiple concurrent games", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameView" } } } } }
      }
    },
    "/api/games/{gameId}": {
      "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "responses": { "200": { "description": "Authoritative game view", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameView" } } } } } }
    },
    "/api/games/{gameId}/join": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "200": { "description": "Joined lobby; existing game participation does not prevent joining" } }
      }
    },
    "/api/games/{gameId}/start": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": { "200": { "description": "Lobby started" } }
      }
    },
    "/api/games/{gameId}/leave": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": {
          "200": { "description": "Left lobby, or forfeited an active multiplayer game; forfeited territories retain their armies as neutral garrisons" },
          "400": { "description": "Practice games must be deleted instead of forfeited" }
        }
      }
    },
    "/api/games/{gameId}/delete": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": {
          "200": { "description": "Practice game and its stored data permanently deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } },
          "400": { "description": "Only practice games may be deleted" },
          "403": { "description": "Only the practice-game creator may delete it" }
        }
      }
    },
    "/api/games/{gameId}/members/{playerId}": {
      "delete": {
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "playerId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": { "200": { "description": "Lobby member removed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/health-rules/propose": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": { "200": { "description": "Health-rule change proposed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/health-rules/vote": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/RevisionBody" }, { "type": "object", "required": ["approve"], "properties": { "approve": { "type": "boolean" } } }] } } } },
        "responses": { "200": { "description": "Health-rule vote recorded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/lobby-health-votes": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["healthRulesVersion", "exerciseKeys"], "properties": { "healthRulesVersion": { "type": "integer", "minimum": 1 }, "exerciseKeys": { "type": "array", "items": { "type": "string" } } } } } } },
        "responses": { "200": { "description": "Lobby health choices saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/reinforce": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/RevisionBody" }, { "type": "object", "properties": { "placements": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } } }] } } } },
        "responses": { "200": { "description": "Reinforcements placed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GameMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/cards/trade": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionBody" } } } },
        "responses": { "200": { "description": "Conquest cards traded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardTradeMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/attack": {
      "post": {
        "parameters": [{ "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttackRequest" } } } },
        "responses": { "200": { "description": "All combat exchanges resolved until capture, stop-loss, or attacker exhaustion", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttackMutationResponse" } } } } }
      }
    },
    "/api/games/{gameId}/fortify": {
      "post": {
