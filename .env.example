# Local development uses the persistent PGlite store in ./.data by default.
NODE_ENV=development
PORT=3000
PGLITE_DIR=./.data

# Hosted deployments must set NODE_ENV=production and provide Postgres.
# Keep sslmode=require when required by your database provider.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/healthrisk?sslmode=require
# DATABASE_MAX_CONNECTIONS=10

