# Local development uses the persistent PGlite store in ./.data by default.
NODE_ENV=development
PORT=3000
PGLITE_DIR=./.data

# Hosted deployments must set NODE_ENV=production and provide Postgres.
# The same database also stores durable pg-boss daily-turn jobs.
# Keep sslmode=require when required by your database provider.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/healthrisk?sslmode=require
# Use a direct connection for migrations and durable background jobs.
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST:5432/healthrisk?sslmode=require
# DATABASE_MAX_CONNECTIONS=10

# Required by the signed Vercel turn-reconciliation cron route. Use a random,
# single-line value and configure the same variable in Vercel Production.
# CRON_SECRET=

# Set only when the hosted app is behind one trusted reverse proxy so login
# rate limiting sees the real client IP.
# TRUST_PROXY=1

# Canonical HTTPS origin used for universal game and invitation links.
# PUBLIC_APP_URL=https://health-risk-ecru.vercel.app

# Native iOS / APNs. The app and website share APPLE_TEAM_ID and IOS_BUNDLE_ID
# for Universal Links. Push delivery activates only when all APNs values exist;
# without them, notifications remain available through the inbox API.
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=com.example.healthrisk
# APNS_KEY_ID=
# Paste the .p8 value with real newlines or escaped \n sequences.
# APNS_PRIVATE_KEY=
